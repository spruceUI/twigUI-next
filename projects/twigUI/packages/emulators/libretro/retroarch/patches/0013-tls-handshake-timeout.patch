@@ -29,6 +29,12 @@
 
 RETRO_BEGIN_DECLS
 
+/* Longest a TLS handshake read waits for the server before failing, so
+ * a silent peer cannot hold the thread forever. */
+#ifndef SSL_SOCKET_IO_TIMEOUT_MS
+#define SSL_SOCKET_IO_TIMEOUT_MS 30000
+#endif
+
 void* ssl_socket_init(int fd, const char *domain);
 
 int ssl_socket_connect(void *state_data, void *data, bool timeout_enable, bool nonblock);
diff --git a/libretro-common/net/net_socket_ssl_mbed.c b/libretro-common/net/net_socket_ssl_mbed.c
