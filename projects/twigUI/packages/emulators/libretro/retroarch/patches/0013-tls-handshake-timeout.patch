    mbedtls_ssl_set_bio(&state->ctx, &state->net_ctx, mbedtls_net_send, mbedtls_net_recv, NULL);
 
+   /* Run the handshake non-blocking with each wait bounded: on a blocking
+    * socket a server that goes silent (WiFi dropped mid-handshake) holds
+    * recv() forever, and RetroArch's exit then hangs waiting on the
+    * RetroAchievements thread. Backport of upstream
+    * https://github.com/libretro/RetroArch/commit/70ba39a934 */
+   if (!socket_set_block(state->net_ctx.fd, false))
+      return -1;
    while ((ret = mbedtls_ssl_handshake(&state->ctx)) != 0)
    {
+      bool rd, wr;
+
       if (ret != MBEDTLS_ERR_SSL_WANT_READ && ret != MBEDTLS_ERR_SSL_WANT_WRITE)
          return -1;
+
+      rd = (ret == MBEDTLS_ERR_SSL_WANT_READ);
+      wr = !rd;
+      if (     !socket_wait(state->net_ctx.fd, &rd, &wr, SSL_SOCKET_IO_TIMEOUT_MS)
+            || !(rd || wr))
+         return -1;
    }
+   if (!socket_set_block(state->net_ctx.fd, true))
+      return -1;
 
    if ((flags = mbedtls_ssl_get_verify_result(&state->ctx)) != 0)
    {
