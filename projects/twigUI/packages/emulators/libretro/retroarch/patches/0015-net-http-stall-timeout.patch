@@ -1487,6 +1538,17 @@ bool net_http_update(struct http_t *state, size_t* progress, size_t* total)
    if (!state || state->err)
       return true;
 
+   if (net_http_stalled(state))
+   {
+      if (state->conn)
+         net_http_conn_pool_remove(state->conn);
+      state->conn            = NULL;
+      state->err             = true;
+      state->response.part   = P_DONE;
+      state->response.status = -1;
+      return true;
+   }
+
    if (!state->conn)
    {
       state->conn = net_http_conn_pool_find(state->request.domain, state->request.port);
