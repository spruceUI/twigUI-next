# Minimal OS variable loading for performance
. /etc/profile.d/001-functions

log "Configure suspend mode..."

cat <<EOF >>/storage/.config/sleep.conf.d/sleep.conf
[Sleep]
AllowSuspend=yes
SuspendState=mem standby freeze
EOF